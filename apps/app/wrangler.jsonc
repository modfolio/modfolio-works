{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "modfolio-works-app",
	"compatibility_date": "2026-03-01",
	"compatibility_flags": ["nodejs_compat"],
	// adapter 14 enables Astro sessions via a SESSION KV binding. Pin the namespace id
	// explicitly — wrangler automatic provisioning is create-only (not idempotent) and
	// fails on redeploy once the namespace exists (API code 10014).
	"kv_namespaces": [
		{ "binding": "SESSION", "id": "371512e24c874c72b1c089678d89d720" }
	],
	// campus.modfolio.io is where the works APP runs. The landing at
	// works.modfolio.io is a static Astro marketing site with no auth, so
	// the SDK's /auth/login and /auth/callback live here — which is also why
	// Connect's client seed now registers a callback on this host rather than
	// only on the landing it could never be served from.
	"routes": [{ "pattern": "campus.modfolio.io", "custom_domain": true }],
	// campus is the sole public entrypoint for the app; a *.workers.dev twin
	// would be an unmonitored second origin for the same authenticated surface.
	"workers_dev": false,
	"preview_urls": false,
	"observability": {
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"destinations": ["modfolio-signoz"],
			"persist": false
		},
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"destinations": ["modfolio-signoz-logs"],
			"persist": false
		}
	}
}

---
import type { HealthState, WorksApp } from "../../lib/apps";

interface Props {
	app: WorksApp;
}

const { app } = Astro.props;
const isActive = app.status === "active";
const monogram = app.name.charAt(0);

// Server-rendered baseline state — the no-JS fallback. An `active` app shows its
// static declared state (`up`); a `landing` app is `coming-soon`. The health
// island (health.ts) upgrades `active` cards loading→live once JS runs.
const initialState: HealthState = isActive ? "up" : "coming-soon";

// Korean copy for the SSR baseline. Mirrors STATE_COPY in health.ts; the island
// overwrites these the moment it resolves, so this is the graceful-degradation text.
const STATE_LABEL: Record<HealthState, string> = {
	up: "정상",
	degraded: "지연",
	down: "점검 중",
	"coming-soon": "준비 중",
};
const STATE_SR: Record<HealthState, string> = {
	up: "정상 작동 중",
	degraded: "응답이 느림",
	down: "접속할 수 없음",
	"coming-soon": "출시 예정",
};
---

<article
	class:list={["app-card", { "app-card--active": isActive }]}
	data-health-card
	data-app-id={app.id}
	data-health-state={initialState}
>
	<div class="app-card__strip" style={`background: ${app.accentVar}`}></div>
	<div class="app-card__content">
		<div class="app-card__top">
			<div class="app-card__icon" style={`color: ${app.accentVar}`} aria-hidden="true">
				{monogram}
			</div>
			<div>
				<h2 class="app-card__name">{app.name}</h2>
				<span class="app-card__domain">{app.domain}</span>
			</div>
		</div>
		<p class="app-card__tagline">{app.tagline}</p>
		<p class="app-card__desc">{app.description}</p>
		<div class="app-card__footer">
			<div class="app-card__health">
				<span class="app-card__dot" data-health-dot role="img" aria-label={STATE_SR[initialState]}></span>
				<span class="app-card__status" data-health-label>{STATE_LABEL[initialState]}</span>
				<!-- Round-trip latency, painted by the island only for up/degraded states.
				     Empty by default (and for every other state) → hidden via :empty. -->
				<span class="app-card__latency" data-health-latency></span>
				<button type="button" class="app-card__retry" data-health-retry>
					<svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
						<path d="M10 6a4 4 0 1 1-1.2-2.8M10 2v2H8" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
					다시 확인
				</button>
			</div>
			{isActive ? (
				<a href={app.url} class="app-card__action" target="_blank" rel="noopener">
					앱 열기
					<svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
						<path d="M3 7h8M8 4l3 3-3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</a>
			) : (
				<span class="app-card__action app-card__action--disabled">준비 중</span>
			)}
		</div>
	</div>
</article>

<style>
	@layer components {
		.app-card {
			display: flex;
			background: var(--color-surface-card);
			border: 1px solid var(--color-border-default);
			border-radius: var(--radius-lg);
			overflow: hidden;
			transition:
				transform var(--dur-base) var(--ease-out),
				border-color var(--dur-fast) var(--ease-out),
				box-shadow var(--dur-fast) var(--ease-out);
		}

		.app-card--active:hover {
			transform: translateY(-2px);
			border-color: var(--color-border-hover);
			box-shadow: var(--shadow-md);
		}

		.app-card:not(.app-card--active):hover {
			border-color: var(--color-border-hover);
		}

		.app-card__strip {
			flex-shrink: 0;
			width: 4px;
		}

		.app-card__content {
			flex: 1;
			padding: var(--space-6);
			display: flex;
			flex-direction: column;
		}

		.app-card__top {
			display: flex;
			align-items: center;
			gap: var(--space-3);
			margin-bottom: var(--space-4);
		}

		.app-card__icon {
			display: flex;
			align-items: center;
			justify-content: center;
			width: 40px;
			height: 40px;
			border-radius: var(--radius-md);
			background: oklch(0.20 0.01 275);
			font-family: var(--font-display);
			font-size: 1.25rem;
			font-weight: 700;
			flex-shrink: 0;
		}

		.app-card__name {
			font-family: var(--font-display);
			font-size: var(--font-size-h3);
			font-weight: 700;
			color: var(--color-text-1);
			line-height: 1.2;
		}

		.app-card__domain {
			font-size: var(--font-size-caption);
			color: var(--color-text-3);
		}

		.app-card__tagline {
			font-size: var(--font-size-body);
			font-weight: 500;
			color: var(--color-text-1);
			margin-bottom: var(--space-2);
		}

		.app-card__desc {
			font-size: var(--font-size-small);
			color: var(--color-text-2);
			line-height: 1.65;
			max-width: 50ch;
			margin-bottom: var(--space-6);
			flex: 1;
		}

		.app-card__footer {
			display: flex;
			align-items: center;
			justify-content: space-between;
		}

		/* ── Live health indicator (dot + label + retry) ────────────────────────
		   State is driven by [data-health-state] on the card root. The visible
		   label text carries the state independently of color (WCAG 1.4.1). */
		.app-card__health {
			display: flex;
			align-items: center;
			gap: var(--space-2);
			/* Reserve a stable row height so loading→resolved swaps never shift
			   layout (CLS 0). Sized to the caption line + dot. */
			min-height: 1.5rem;
		}

		.app-card__dot {
			flex-shrink: 0;
			width: 8px;
			height: 8px;
			border-radius: var(--radius-full);
			/* Neutral default; per-state color set below. */
			background: var(--color-text-3);
		}

		.app-card__status {
			font-size: var(--font-size-caption);
			font-family: var(--font-ui);
			letter-spacing: 0.02em;
			color: var(--color-text-2);
		}

		/* Round-trip latency — deliberately quiet (text-3, tabular digits so the
		   number doesn't jitter as it updates). Hidden entirely when the island
		   leaves it empty (coming-soon / down / loading / error), so the row has
		   no dangling separator in those states. */
		.app-card__latency {
			font-size: var(--font-size-caption);
			font-family: var(--font-ui);
			font-variant-numeric: tabular-nums;
			color: var(--color-text-3);
		}

		.app-card__latency:empty {
			display: none;
		}

		/* A subtle dot separator before the latency, only when it is shown. */
		.app-card__latency:not(:empty)::before {
			content: "·";
			margin-right: var(--space-2);
			color: var(--color-text-3);
		}

		/* up → success */
		[data-health-state="up"] .app-card__dot { background: var(--color-success); }
		[data-health-state="up"] .app-card__status { color: var(--color-success); }

		/* degraded → warning */
		[data-health-state="degraded"] .app-card__dot { background: var(--color-warning); }
		[data-health-state="degraded"] .app-card__status { color: var(--color-warning); }

		/* down → danger */
		[data-health-state="down"] .app-card__dot { background: var(--color-danger); }
		[data-health-state="down"] .app-card__status { color: var(--color-danger); }

		/* coming-soon → parchment accent (matches the old landing pill hue) */
		[data-health-state="coming-soon"] .app-card__dot { background: var(--color-accent-fortiscribe); }
		[data-health-state="coming-soon"] .app-card__status { color: var(--color-accent-fortiscribe); }

		/* error → muted, with a retry affordance */
		[data-health-state="error"] .app-card__dot { background: var(--color-text-3); }
		[data-health-state="error"] .app-card__status { color: var(--color-text-3); }

		/* loading → skeleton dot with a gentle pulse; label dimmed */
		[data-health-state="loading"] .app-card__dot {
			background: var(--color-text-3);
			animation: health-pulse var(--dur-slow) var(--ease-float) infinite;
		}
		[data-health-state="loading"] .app-card__status { color: var(--color-text-3); }

		@keyframes health-pulse {
			0%, 100% { opacity: 0.35; }
			50% { opacity: 1; }
		}

		/* Reduced motion: no pulse — show the dot at a steady, legible opacity. */
		@media (prefers-reduced-motion: reduce) {
			[data-health-state="loading"] .app-card__dot {
				animation: none;
				opacity: 0.7;
			}
		}

		/* Retry button — only revealed in the error state. */
		.app-card__retry {
			display: none;
			align-items: center;
			gap: var(--space-1);
			padding: var(--space-1) var(--space-2);
			border: 1px solid var(--color-border-default);
			border-radius: var(--radius-sm);
			background: transparent;
			font-family: var(--font-ui);
			font-size: var(--font-size-caption);
			color: var(--color-text-2);
			cursor: pointer;
			transition:
				border-color var(--dur-fast) var(--ease-out),
				color var(--dur-fast) var(--ease-out);
		}

		[data-health-state="error"] .app-card__retry {
			display: inline-flex;
		}

		.app-card__retry:hover {
			border-color: var(--color-border-hover);
			color: var(--color-text-1);
		}

		.app-card__action {
			display: inline-flex;
			align-items: center;
			gap: var(--space-2);
			font-size: var(--font-size-small);
			font-weight: 600;
			color: var(--color-text-1);
			transition: color var(--dur-fast) var(--ease-out);
		}

		.app-card__action:hover {
			color: var(--color-interactive-primary);
		}

		.app-card__action--disabled {
			color: var(--color-text-3);
			cursor: default;
		}

		.app-card__action--disabled:hover {
			color: var(--color-text-3);
		}
	}
</style>

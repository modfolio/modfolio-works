{
	"permissions": {
		"allow": [
			"Bash(bun run check:*)",
			"Bash(bun run check)",
			"Bash(bun run typecheck)",
			"Bash(bun run typecheck:*)",
			"Bash(bun run harness-pull)",
			"Bash(bun run harness-pull:*)",
			"Bash(bun run dev)",
			"Bash(bun run dev:*)",
			"Bash(bun run build)",
			"Bash(bun run build:*)",
			"Bash(bun run deploy)",
			"Bash(bun run modfolio)",
			"Bash(bun run modfolio:*)",
			"Bash(bun run json-diff)",
			"Bash(bun run json-diff:*)",
			"Bash(bun run ts7)",
			"Bash(bun run ts7:*)",
			"Bash(bun run verify)",
			"Bash(bun run verify:*)",
			"Bash(bun run heavy)",
			"Bash(bun run heavy:*)",
			"Bash(bun run test:*)",
			"Bash(bun run lint)",
			"Bash(bun run lint:*)",
			"Bash(bun run format)",
			"Bash(bun run format:*)",
			"Bash(bun run quality:*)",
			"Bash(git status*)",
			"Bash(git diff*)",
			"Bash(git log*)",
			"Bash(git branch*)",
			"Bash(git show*)"
		],
		"defaultMode": "bypassPermissions",
		"deny": [
			"Edit(.claude/payment-approval.json)",
			"Bash(*payment-approval.json*)"
		]
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "bun run \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-destructive-guard.ts\""
					},
					{
						"type": "command",
						"command": "bun run \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-payment-guard.ts\""
					}
				]
			},
			{
				"matcher": "mcp__.*",
				"hooks": [
					{
						"type": "command",
						"command": "bun run \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-payment-guard.ts\""
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun run \"$CLAUDE_PROJECT_DIR/node_modules/@modfolio/harness/scripts/hooks/user-prompt-playbook-inject.ts\""
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun run \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-debrief-check.ts\""
					}
				]
			}
		],
		"SessionStart": [
			{
				"matcher": ".*",
				"hooks": [
					{
						"type": "command",
						"command": "bun run \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start-pickup.ts\""
					}
				]
			}
		]
	},
	"effortLevel": "xhigh"
}
